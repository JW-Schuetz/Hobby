\begin_layout Standard
Wegen der kosmischen Expansion gilt mit dem zeitvarianten Skalenfaktor 
\begin_inset Formula $a\left(t\right)$
\end_inset

 die Gleichung
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{eqnarray}
R\left(t\right) & = & a\left(t\right)R_{0}.\label{eq:R}
\end{eqnarray}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
Dabei ist 
\begin_inset Formula $R_{0}$
\end_inset

 der Radius zur Zeit 
\begin_inset Formula $t_{0}=0.$
\end_inset

 Es gilt mit der Hubblekonstanten 
\begin_inset Formula $H$
\end_inset

 die Proportionalität
\begin_inset Formula 
\begin{eqnarray*}
\dot{R} & = & HR
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Plain Layout
und durch Einsetzen folgt
\end_layout

\begin_layout Plain Layout
\begin_inset Formula 
\begin{eqnarray*}
H & = & \frac{\dot{a}\left(t\right)}{a\left(t\right)}.
\end{eqnarray*}

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
Durch die kosmische Expansion bewege sich die Masse 
\begin_inset Formula $m$
\end_inset

 radial nach aussen.
 Die als homogen und isotrop angenommene Massedichte im Universum sei 
\begin_inset Formula $\rho.$
\end_inset

 
\end_layout

\begin_layout Standard
Innerhalb des Radius 
\begin_inset Formula $R$
\end_inset

 befindet sich also die Masse
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{eqnarray*}
M & = & \rho V=\rho\frac{4\pi}{3}R^{3}.
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
Für die kinetische und potentielle Energie der Galaxie folgen die Gleichungen
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{eqnarray*}
E_{K} & = & \frac{m}{2}\left(\dot{R}\right)^{2}\\
E_{P} & = & -G\frac{mM}{R}.
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
Somit folgt mit einer Konstanten 
\begin_inset Formula $C$
\end_inset

 die Energiebilanz
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{eqnarray*}
E_{K}+E_{P} & = & C\\
\frac{m}{2}\left(\dot{R}\right)^{2}-G\frac{mM}{R} & = & C.
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
Durch Einsetzen von Gleichung (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:R"
plural "false"
caps "false"
noprefix "false"
nolink "false"

\end_inset

) und Vereinfachung folgt
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{eqnarray*}
\frac{m}{2}\left[a\left(t\right)R_{0}\right]^{2}-G\frac{mM}{a\left(t\right)R_{0}} & = & C\\
a^{2}\left(t\right)R_{0}^{2}-G\frac{2M}{a\left(t\right)R_{0}} & = & \frac{2C}{m}\\
a^{2}\left(t\right)R_{0}^{2}-G\frac{2\rho\frac{4\pi}{3}R^{3}}{a\left(t\right)R_{0}} & = & \frac{2C}{m}\\
a^{2}\left(t\right)R_{0}^{2}-G\frac{8\pi\rho\left[a\left(t\right)R_{0}\right]^{3}}{3a\left(t\right)R_{0}} & = & \frac{2C}{m}\\
a^{2}\left(t\right)R_{0}^{2}-\frac{8\pi}{3}G\rho a\left(t\right)R_{0}^{2} & = & \frac{2C}{m}\\
\\\\\\\dot{a}^{2}\left(t\right)R_{0}^{2}-2G\frac{\rho\frac{4\pi}{3}R^{3}}{R} & = & \frac{2C}{m}\\
\dot{a}^{2}\left(t\right)R_{0}^{2}-G\rho\frac{8\pi}{3}a^{3}\left(t\right)R_{0}^{3} & = & \frac{2C}{m}.
\end{eqnarray*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{eqnarray*}
\dot{a}^{2}\left(t\right)R_{0}^{2}-G\rho\frac{8\pi}{3}a^{3}\left(t\right)R_{0}^{3} & = & \frac{2C}{m}.
\end{eqnarray*}

\end_inset


